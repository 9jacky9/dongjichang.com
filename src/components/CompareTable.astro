---
interface Brand {
  name: string;
  score: number;
  price: string;
  protocol: string;
  link: string;
  tags: string[];
}

interface Props {
  brands: Brand[];
}

const { brands } = Astro.props;

const getTagColor = (tag: string) => {
  if (tag.includes('游戏')) return 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300';
  if (tag.includes('流媒体') || tag.includes('视频')) return 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300';
  if (tag.includes('办公') || tag.includes('外贸')) return 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300';
  if (tag.includes('下载') || tag.includes('大流量')) return 'bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-300';
  return 'bg-[var(--bg-color)] text-[var(--text-color)]/80 border border-[var(--border-color)]';
};
---

<div class="my-8 overflow-x-auto pb-4 custom-scrollbar">
  <table class="w-full min-w-[900px] border-collapse">
    <thead>
      <tr class="text-left text-sm font-semibold text-[var(--text-color)]/70 border-b border-[var(--border-color)]">
        <th class="py-4 px-4">品牌</th>
        <th class="py-4 px-4 w-40">综合评分</th>
        <th class="py-4 px-4">适用场景</th>
        <th class="py-4 px-4">起步价格</th>
        <th class="py-4 px-4">主流协议</th>
        <th class="py-4 px-4 text-right">操作</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-[var(--border-color)]/50">
      {brands.map(brand => {
        // Calculate progress bar width (max 5.0)
        const percent = Math.min(100, Math.max(0, (brand.score / 5) * 100));

        return (
          <tr class="hover:bg-[var(--bg-color)]/30 transition-colors group">
            <td class="py-4 px-4">
              <span class="font-bold text-[var(--text-color)] text-lg">{brand.name}</span>
            </td>
            <td class="py-4 px-4">
              <div class="flex flex-col gap-1.5 w-full max-w-[120px]">
                <div class="flex justify-between items-center text-sm">
                  <div class="flex items-center gap-1 font-bold text-warning">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    {brand.score.toFixed(1)}
                  </div>
                  <span class="text-[10px] text-[var(--text-color)]/50 font-medium">/ 5.0</span>
                </div>
                <div class="w-full h-1.5 bg-[var(--bg-color)] rounded-full overflow-hidden">
                  <div class="h-full bg-gradient-to-r from-warning to-orange-400 rounded-full" style={`width: ${percent}%`}></div>
                </div>
              </div>
            </td>
            <td class="py-4 px-4">
              <div class="flex flex-wrap gap-1.5">
                {brand.tags.map(tag => (
                  <span class={`text-[11px] font-medium px-2 py-0.5 rounded-full ${getTagColor(tag)}`}>
                    {tag}
                  </span>
                ))}
                {brand.tags.length === 0 && <span class="text-xs text-[var(--text-color)]/40">-</span>}
              </div>
            </td>
            <td class="py-4 px-4">
              <span class="font-mono font-medium text-[var(--text-color)]">{brand.price}</span>
            </td>
            <td class="py-4 px-4 text-sm font-medium text-[var(--text-color)]/70">
              {brand.protocol || '未公开'}
            </td>
            <td class="py-4 px-4 text-right">
              <a 
                href={brand.link} 
                target="_blank"
                rel="nofollow sponsored"
                class="inline-block px-4 py-2 bg-primary-500 hover:bg-primary-600 text-white text-sm font-bold rounded-lg transition-all shadow-sm hover:shadow-md shadow-primary-500/20 hover:-translate-y-0.5"
              >
                前往官网
              </a>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    height: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: var(--bg-color);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: var(--border-color);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: var(--color-cloud-800);
  }
</style>
