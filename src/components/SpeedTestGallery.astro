---
interface SpeedTest {
  region: string;
  nodeCount: number;
  avgLatencyMs: number;
  avgSpeedMbps: number;
  maxSpeedMbps?: number;
  testDate: Date;
  note?: string;
}

interface Props {
  tests?: SpeedTest[];
  brandName: string;
}

const { tests = [], brandName } = Astro.props;
---

{tests && tests.length > 0 && (
  <div class="my-8">
    <h2 class="text-2xl font-bold text-[var(--text-color)] mb-4">{brandName} 晚高峰实测数据</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {tests.map((test) => (
        <div class="bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-5 hover:border-primary-400 transition-colors shadow-sm">
          <div class="flex justify-between items-start mb-4">
            <div>
              <h3 class="font-bold text-lg text-[var(--text-color)]">{test.region}</h3>
              <p class="text-xs text-[var(--text-color)]/60 mt-1">共 {test.nodeCount} 个可用节点</p>
            </div>
            <time class="text-xs text-[var(--text-color)]/60 bg-[var(--bg-color)] px-2.5 py-1 rounded-full border border-[var(--border-color)]">
              {test.testDate.toISOString().split('T')[0]}
            </time>
          </div>
          
          <div class="space-y-4">
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span class="text-[var(--text-color)]/70">平均延迟</span>
                <span class="font-mono text-primary-600 font-medium">{test.avgLatencyMs} ms</span>
              </div>
              <div class="w-full bg-[var(--bg-color)] rounded-full h-2">
                <div class="bg-primary-400 h-2 rounded-full" style={`width: ${Math.min((test.avgLatencyMs / 500) * 100, 100)}%`}></div>
              </div>
            </div>
            
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span class="text-[var(--text-color)]/70">平均速度</span>
                <span class="font-mono text-accent-600 font-medium">{test.avgSpeedMbps} Mbps</span>
              </div>
              <div class="w-full bg-[var(--bg-color)] rounded-full h-2">
                <div class="bg-accent-500 h-2 rounded-full" style={`width: ${Math.min((test.avgSpeedMbps / 1000) * 100, 100)}%`}></div>
              </div>
            </div>
          </div>

          {(test.maxSpeedMbps || test.note) && (
            <div class="mt-4 pt-4 border-t border-[var(--border-color)] text-xs text-[var(--text-color)]/70">
              {test.maxSpeedMbps && <p>峰值速率: <span class="font-mono">{test.maxSpeedMbps} Mbps</span></p>}
              {test.note && <p class="mt-1">{test.note}</p>}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
)}
