---
const { data = [] } = Astro.props;

// Sort by avgSpeedMbps descending
const sortedData = [...data].sort((a, b) => b.avgSpeedMbps - a.avgSpeedMbps);
const maxSpeed = Math.max(...sortedData.map(d => d.avgSpeedMbps), 1);
---

{sortedData.length > 0 ? (
  <div class="bg-[var(--card-bg)] border border-[var(--border-color)] rounded-2xl p-6 shadow-sm my-8 not-prose">
    <h3 class="font-bold text-[var(--text-color)] text-xl mb-6 flex items-center gap-2">
      <svg class="w-6 h-6 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
      核心节点实测速度
    </h3>
    
    <div class="space-y-4">
      {sortedData.map(item => {
        const percentage = Math.min(100, Math.max(5, (item.avgSpeedMbps / maxSpeed) * 100));
        return (
          <div class="flex flex-col gap-1">
            <div class="flex justify-between items-end text-sm">
              <span class="font-bold text-[var(--text-color)]">{item.region} <span class="text-[var(--text-color)]/50 font-normal ml-1">({item.nodeCount} 节点)</span></span>
              <span class="font-mono text-[var(--text-color)]">{item.avgSpeedMbps} Mbps <span class="text-xs text-[var(--text-color)]/50 ml-1">延迟: {item.avgLatencyMs}ms</span></span>
            </div>
            <div class="w-full bg-[var(--bg-color)] rounded-full h-2.5 overflow-hidden">
              <div class="bg-gradient-to-r from-primary-400 to-primary-600 h-2.5 rounded-full transition-all duration-500" style={`width: ${percentage}%`}></div>
            </div>
            {item.note && <div class="text-xs text-[var(--text-color)]/50 mt-1">{item.note}</div>}
          </div>
        );
      })}
    </div>
  </div>
) : null}
