---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);

// TOC filtering (only h2 and h3)
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);

// Estimate reading time (assuming ~400 chars per minute for Chinese)
// In Astro 5, post.body is the raw string
const wordCount = post.body ? post.body.length : 2000;
const readingTime = Math.max(1, Math.ceil(wordCount / 400));

// Related articles
const relatedPosts = allPosts
  .filter(p => p.id !== post.id && !p.data.draft)
  .filter(p => 
    p.data.articleType === post.data.articleType || 
    p.data.keywords.some(k => post.data.keywords.includes(k))
  )
  .slice(0, 3);
---

<BaseLayout 
  title={post.data.title} 
  description={post.data.description}
>
  <div class="bg-[var(--bg-color)] border-b border-[var(--border-color)] py-12 md:py-16">
    <div class="container mx-auto px-4 max-w-4xl text-center">
      <div class="flex items-center justify-center gap-3 mb-6">
        <span class="text-sm font-bold bg-primary-50 text-primary-600 dark:bg-primary-900/30 dark:text-primary-400 px-3 py-1 rounded-full border border-primary-200 dark:border-primary-800">
          {post.data.articleType === 'roundup' ? '推荐榜' : post.data.articleType === 'deep-dive' ? '深度测评' : '教程科普'}
        </span>
      </div>
      
      <h1 class="text-3xl md:text-5xl font-black text-[var(--text-color)] mb-6 leading-tight">
        {post.data.title}
      </h1>
      
      <div class="flex flex-wrap items-center justify-center gap-4 text-sm font-medium text-[var(--text-color)]/60">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          <time datetime={post.data.publishDate.toISOString()}>{post.data.publishDate.toISOString().split('T')[0]}</time>
        </div>
        <div class="w-1.5 h-1.5 rounded-full bg-[var(--border-color)]"></div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span>约 {readingTime} 分钟阅读</span>
        </div>
      </div>
    </div>
  </div>

  <article class="container mx-auto px-4 py-12 max-w-6xl">
    
    <div class="flex flex-col lg:flex-row gap-12 items-start relative">
      
      {/* Sidebar TOC */}
      <aside class="hidden lg:block w-72 shrink-0 sticky top-24">
        <div class="bg-[var(--card-bg)] border border-[var(--border-color)] p-6 rounded-2xl shadow-sm">
          <h3 class="font-bold text-[var(--text-color)] mb-4 text-lg border-b border-[var(--border-color)] pb-3">目录 (TOC)</h3>
          <ul class="space-y-2.5 text-sm">
            {toc.map(heading => (
              <li class={`${heading.depth === 3 ? 'ml-4 text-[var(--text-color)]/70' : 'font-medium text-[var(--text-color)]/90'}`}>
                <a href={`#${heading.slug}`} class="hover:text-primary-500 transition-colors block truncate" title={heading.text}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>

      {/* Main Content */}
      <div class="w-full lg:max-w-3xl lg:flex-1">
        {post.data.coverImage && (
          <div class="mb-10 rounded-2xl overflow-hidden shadow-sm border border-[var(--border-color)]">
            <Image 
              src={post.data.coverImage} 
              alt={post.data.title} 
              class="w-full h-auto aspect-video object-cover" 
            />
          </div>
        )}

        <div class="prose prose-lg dark:prose-invert prose-primary max-w-none 
          prose-headings:text-[var(--text-color)] prose-headings:font-bold 
          prose-a:text-primary-600 dark:prose-a:text-primary-400 hover:prose-a:text-primary-500 
          prose-img:rounded-2xl prose-img:border prose-img:border-[var(--border-color)] prose-img:shadow-sm
          prose-blockquote:border-l-4 prose-blockquote:border-primary-500 prose-blockquote:bg-[var(--card-bg)] prose-blockquote:py-2 prose-blockquote:px-6 prose-blockquote:rounded-r-xl prose-blockquote:shadow-sm prose-blockquote:not-italic
        ">
          {/* Mobile TOC */}
          {toc.length > 0 && (
            <div class="lg:hidden mb-8 bg-[var(--card-bg)] border border-[var(--border-color)] p-6 rounded-2xl">
              <h3 class="font-bold text-lg mb-4 !mt-0">文章目录</h3>
              <ul class="space-y-2 text-sm m-0 p-0 list-none">
                {toc.map(heading => (
                  <li class={`${heading.depth === 3 ? 'ml-4 text-[var(--text-color)]/70' : 'font-medium text-[var(--text-color)]/90'} m-0`}>
                    <a href={`#${heading.slug}`} class="hover:text-primary-500 no-underline block truncate">
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <Content />
        </div>

        {/* Footer actions */}
        <div class="mt-16 pt-8 border-t border-[var(--border-color)]">
          
          <div class="flex flex-wrap gap-2 mb-10">
            <span class="text-sm font-bold text-[var(--text-color)]/60 mr-2 flex items-center">标签:</span>
            {post.data.keywords.map(kw => (
              <span class="text-xs text-[var(--text-color)]/70 bg-[var(--card-bg)] border border-[var(--border-color)] px-3 py-1.5 rounded-full">
                #{kw}
              </span>
            ))}
          </div>

          {post.data.relatedBrands && post.data.relatedBrands.length > 0 && (
            <div class="mb-12">
               <h3 class="text-xl font-bold mb-5 text-[var(--text-color)]">文中提到的品牌</h3>
               <div class="flex flex-wrap gap-4">
                  {post.data.relatedBrands.map(brand => (
                     <a href={`/reviews/${brand}`} class="bg-[var(--card-bg)] border border-[var(--border-color)] hover:border-primary-500 px-5 py-3 rounded-xl text-[var(--text-color)] font-medium transition-colors shadow-sm flex items-center gap-2">
                       前往 {brand} 详细评测 <svg class="w-4 h-4 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                     </a>
                  ))}
               </div>
            </div>
          )}

          {relatedPosts.length > 0 && (
            <div>
              <h3 class="text-xl font-bold mb-5 text-[var(--text-color)]">相关文章阅读</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {relatedPosts.map(rp => (
                  <a href={`/blog/${rp.id}`} class="bg-[var(--card-bg)] border border-[var(--border-color)] hover:border-primary-400 p-4 rounded-xl transition-all shadow-sm hover:shadow-md flex flex-col justify-between h-full group">
                    <h4 class="font-bold text-[var(--text-color)] group-hover:text-primary-500 line-clamp-2 mb-2">{rp.data.title}</h4>
                    <span class="text-xs text-[var(--text-color)]/50">{rp.data.publishDate.toISOString().split('T')[0]}</span>
                  </a>
                ))}
              </div>
            </div>
          )}

        </div>
      </div>
      
    </div>
  </article>
</BaseLayout>
