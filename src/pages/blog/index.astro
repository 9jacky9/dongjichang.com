---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
// Filter out drafts and sort by publish date descending, put pinned at top
const posts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => {
    if (a.data.pinned && !b.data.pinned) return -1;
    if (!a.data.pinned && b.data.pinned) return 1;
    return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
  });
---

<BaseLayout title="懂机场 - 博客与教程" description="最新机场评测、选购指南与翻墙教程">
  <div class="container mx-auto px-4 py-12">
    <h1 class="text-4xl font-extrabold text-[var(--text-color)] mb-8 text-center tracking-tight">内容与教程</h1>
    
    <!-- Controls (Search + Filter Tabs) -->
    <div class="max-w-4xl mx-auto mb-10 flex flex-col md:flex-row gap-4 justify-between items-center bg-[var(--card-bg)] p-4 rounded-xl border border-[var(--border-color)] shadow-sm">
      <div class="flex gap-2 overflow-x-auto w-full md:w-auto hide-scrollbar pb-2 md:pb-0" style="scrollbar-width: none;">
        <button class="filter-btn cursor-pointer px-4 py-2 rounded-full font-medium text-sm bg-primary-500 text-white transition-colors" data-type="all">全部</button>
        <button class="filter-btn cursor-pointer px-4 py-2 rounded-full font-medium text-sm bg-[var(--bg-color)] text-[var(--text-color)] hover:bg-primary-50 transition-colors" data-type="roundup">推荐榜</button>
        <button class="filter-btn cursor-pointer px-4 py-2 rounded-full font-medium text-sm bg-[var(--bg-color)] text-[var(--text-color)] hover:bg-primary-50 transition-colors" data-type="deep-dive">深度测评</button>
        <button class="filter-btn cursor-pointer px-4 py-2 rounded-full font-medium text-sm bg-[var(--bg-color)] text-[var(--text-color)] hover:bg-primary-50 transition-colors" data-type="guide">教程科普</button>
      </div>
      
      <div class="relative w-full md:w-64">
        <input type="text" id="search-input" placeholder="搜索文章..." class="w-full pl-10 pr-4 py-2 rounded-full border border-[var(--border-color)] bg-[var(--bg-color)] text-[var(--text-color)] focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500 text-sm transition-shadow">
        <svg class="w-4 h-4 absolute left-4 top-3 text-[var(--text-color)]/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </div>
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto" id="posts-container">
      {posts.map((post) => {
        let cardClass = "post-card bg-[var(--card-bg)] border border-[var(--border-color)] rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 relative flex flex-col group hover:-translate-y-1";
        if (post.data.articleType === 'roundup') {
          cardClass += " border-2 border-primary-500 ring-4 ring-primary-500/10";
        }

        let typeLabel = '';
        let typeIcon = '';
        if (post.data.articleType === 'roundup') { typeLabel = '推荐榜'; typeIcon = '🏆'; }
        if (post.data.articleType === 'deep-dive') { typeLabel = '深度测评'; typeIcon = '🔍'; }
        if (post.data.articleType === 'guide') { typeLabel = '教程科普'; typeIcon = '📖'; }

        return (
          <a href={`/blog/${post.id}`} class={cardClass} data-type={post.data.articleType} data-title={post.data.title.toLowerCase()} data-keywords={post.data.keywords.join(',').toLowerCase()}>
            {post.data.pinned && (
              <div class="absolute top-0 right-0 bg-accent-500 text-white text-xs font-bold px-3 py-1.5 rounded-bl-lg z-10 shadow-sm">置顶推荐</div>
            )}
            <div class="p-6 flex flex-col h-full">
              <div class="flex items-center gap-2 mb-4">
                <span class="text-xl">{typeIcon}</span>
                <span class="text-xs font-bold text-primary-600 bg-primary-50 px-2.5 py-1 rounded-md">{typeLabel}</span>
                <time class="text-xs text-[var(--text-color)]/50 ml-auto font-medium">{post.data.publishDate.toISOString().split('T')[0]}</time>
              </div>
              <h2 class="text-xl font-bold text-[var(--text-color)] mb-3 line-clamp-2 leading-snug group-hover:text-primary-600 transition-colors">{post.data.title}</h2>
              <p class="text-sm text-[var(--text-color)]/70 line-clamp-3 mb-6 flex-grow leading-relaxed">{post.data.description}</p>
              <div class="mt-auto pt-4 border-t border-[var(--border-color)] flex flex-wrap gap-2">
                {post.data.keywords.slice(0, 3).map(kw => (
                  <span class="text-[11px] text-[var(--text-color)]/60 bg-[var(--bg-color)] px-2.5 py-1 rounded-full border border-[var(--border-color)]">#{kw}</span>
                ))}
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- No Results -->
    <div id="no-results" class="hidden text-center py-24">
      <div class="text-4xl mb-4 opacity-50">📭</div>
      <p class="text-[var(--text-color)]/60 text-lg font-medium">没有找到匹配的文章</p>
    </div>

    <!-- Pagination -->
    <div class="flex justify-center mt-12 gap-2" id="pagination">
      <!-- Generated by JS -->
    </div>

  </div>
</BaseLayout>

<script>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', () => {
    const PAGE_SIZE = 6;
    const posts = Array.from(document.querySelectorAll('.post-card'));
    const filterBtns = document.querySelectorAll('.filter-btn');
    const searchInput = document.getElementById('search-input');
    const paginationContainer = document.getElementById('pagination');
    const noResults = document.getElementById('no-results');

    let currentType = 'all';
    let currentSearch = '';
    let currentPage = 1;

    function render() {
      let filtered = posts.filter(post => {
        const type = post.getAttribute('data-type');
        const title = post.getAttribute('data-title') || '';
        const keywords = post.getAttribute('data-keywords') || '';
        
        const typeMatch = currentType === 'all' || type === currentType;
        const searchMatch = !currentSearch || title.includes(currentSearch) || keywords.includes(currentSearch);
        
        return typeMatch && searchMatch;
      });

      const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
      if (currentPage > totalPages) currentPage = Math.max(1, totalPages);

      // Hide all first
      posts.forEach(post => post.style.display = 'none');

      if (filtered.length === 0) {
        noResults.classList.remove('hidden');
        paginationContainer.innerHTML = '';
        return;
      } else {
        noResults.classList.add('hidden');
      }

      // Show current page
      const start = (currentPage - 1) * PAGE_SIZE;
      const end = start + PAGE_SIZE;
      filtered.slice(start, end).forEach(post => {
        post.style.display = 'flex';
      });

      // Render pagination buttons
      paginationContainer.innerHTML = '';
      if (totalPages > 1) {
          for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.textContent = i.toString();
          btn.className = `cursor-pointer w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold transition-all ${i === currentPage ? 'bg-primary-500 text-white shadow-md' : 'bg-[var(--card-bg)] text-[var(--text-color)] border border-[var(--border-color)] hover:bg-primary-50 hover:text-primary-600'}`;
          btn.addEventListener('click', () => {
            currentPage = i;
            render();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
          paginationContainer.appendChild(btn);
        }
      }
    }

    // Event Listeners
    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-primary-500', 'text-white');
          b.classList.add('bg-[var(--bg-color)]', 'text-[var(--text-color)]');
        });
        const target = e.currentTarget;
        target.classList.remove('bg-[var(--bg-color)]', 'text-[var(--text-color)]');
        target.classList.add('bg-primary-500', 'text-white');
        
        currentType = target.getAttribute('data-type') || 'all';
        currentPage = 1;
        render();
      });
    });

    searchInput.addEventListener('input', (e) => {
      currentSearch = e.target.value.toLowerCase().trim();
      currentPage = 1;
      render();
    });

    // Init
    render();
  });
</script>
