---
import BaseLayout from '../../layouts/BaseLayout.astro';

const scenes = [
  { id: 'stable', title: '稳定优先', desc: '全IPLC/IEPL专线，晚高峰无惧拥堵，办公与外贸首选。', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { id: 'budget', title: '极致便宜', desc: '低至几元一月，高性价比，满足日常网页浏览和查资料。', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { id: 'heavy-traffic', title: '大流量重度下载', desc: '提供T级别或无限制流量，适合PT、大文件下载。', icon: 'M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12' },
  { id: 'ai-power', title: 'AI重度使用', desc: '原生家庭宽带IP，无缝解锁 ChatGPT, Claude 等 AI 工具。', icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { id: 'streaming-hq', title: '流媒体高画质', desc: '完美原生IP解锁，支持 Netflix/Disney+ 4K 晚高峰秒开。', icon: 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { id: 'beginner', title: '新手友好', desc: '提供完善的客户端和一键导入，客服响应快，少折腾。', icon: 'M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' }
];
---

<BaseLayout 
  title="场景化推荐榜单" 
  description="根据不同的使用场景（流媒体解锁、游戏专线、平价日常）推荐最合适的节点服务。"
>
  <div class="bg-[var(--card-bg)] border-b border-[var(--border-color)]">
    <div class="container mx-auto px-4 py-16 text-center max-w-3xl">
      <h1 class="text-4xl font-bold mb-4 text-[var(--text-color)]">场景推荐榜单</h1>
      <p class="text-lg text-[var(--text-color)]/70">
        没有最好的服务，只有最适合的方案。根据您的实际用途，选择下面对应的专区。
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 py-16 max-w-6xl">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {scenes.map(scene => (
        <a href={`/best/${scene.id}`} class="group p-8 bg-[var(--card-bg)] border border-[var(--border-color)] rounded-2xl hover:border-accent-500 hover:shadow-xl hover:shadow-accent-500/10 transition-all text-center">
          <div class="w-16 h-16 mx-auto bg-accent-50 dark:bg-accent-900/30 text-accent-500 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={scene.icon}></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-[var(--text-color)] mb-3">{scene.title}</h2>
          <p class="text-[var(--text-color)]/70 leading-relaxed">{scene.desc}</p>
          <div class="mt-6 inline-flex items-center text-accent-600 dark:text-accent-400 font-medium group-hover:underline">
            查看榜单详情 <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
