---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RatingBadge from '../../components/RatingBadge.astro';
import PricingTable from '../../components/PricingTable.astro';
import ProsConsList from '../../components/ProsConsList.astro';
import CouponCode from '../../components/CouponCode.astro';
import CTAButton from '../../components/CTAButton.astro';
import SpeedTestGallery from '../../components/SpeedTestGallery.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import DongSays from '../../components/DongSays.astro';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map(review => ({
    params: { slug: review.id },
    props: { review },
  }));
}

const { review } = Astro.props;
const { data } = review;
const { Content } = await render(review);

const structuredData = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": data.name,
  "description": data.summary,
  "review": {
    "@type": "Review",
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": data.rating.overall,
      "bestRating": "5",
      "worstRating": "0"
    },
    "author": {
      "@type": "Organization",
      "name": "懂机场"
    }
  }
};
---

<BaseLayout 
  title={data.metaTitle} 
  description={data.metaDescription}
  ogImage="/assets/og-template.svg"
  articleDate={data.updatedDate}
>
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <!-- Breadcrumb -->
    <nav class="flex text-sm text-[var(--text-color)]/60 mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href="/" class="hover:text-primary-500 transition-colors">首页</a>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <a href="/brands" class="hover:text-primary-500 transition-colors ml-1 md:ml-2">评测库</a>
          </div>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <span class="ml-1 md:ml-2 text-[var(--text-color)]">{data.name} 评测</span>
          </div>
        </li>
      </ol>
    </nav>

    <!-- Header Section -->
    <header class="mb-12 flex flex-col md:flex-row gap-8 items-start">
      <div class="w-24 h-24 shrink-0 rounded-2xl overflow-hidden shadow-sm bg-[var(--card-bg)] border border-[var(--border-color)] p-1">
        <!-- SVG Placeholder mapping based on brand name for now, normally use image() -->
        <div class="w-full h-full  rounded-xl bg-primary-500 text-white flex items-center justify-center font-bold text-xl uppercase rounded-xl">
  {review.data.name.charAt(0)}
</div>
      </div>
      
      <div class="flex-grow">
        <h1 class="text-3xl md:text-4xl font-bold text-[var(--text-color)] mb-4">{data.name} 深度评测</h1>
        <p class="text-lg text-[var(--text-color)]/80 leading-relaxed mb-6">{data.summary}</p>
        
        <div class="flex flex-wrap gap-4 items-center">
          <div class="bg-[var(--card-bg)] px-4 py-2 rounded-lg border border-[var(--border-color)]">
            <RatingBadge score={data.rating.overall} size="lg" label="综合评分" />
          </div>
          <DongSays verdict={data.dongSays} />
          <div class="text-sm text-[var(--text-color)]/60">
            最后更新于: <time datetime={data.updatedDate.toISOString()}>{data.updatedDate.toISOString().split('T')[0]}</time>
          </div>
        </div>
      </div>
    </header>

    <!-- Coupon Section -->
    {data.coupon && (
      <CouponCode code={data.coupon} desc={data.couponDesc} />
    )}

    <!-- Pros & Cons -->
    <ProsConsList pros={data.pros} cons={data.cons} />

    <!-- Content (MDX Render) -->
    <article class="prose dark:prose-invert prose-primary max-w-none my-12">
      <Content />
    </article>

    <!-- Pricing Table -->
    {data.pricing && data.pricing.length > 0 && (
      <PricingTable plans={data.pricing} affiliateLink={data.affiliateLink} />
    )}

    <!-- Speed Tests -->
    {data.speedTests && data.speedTests.length > 0 && (
      <SpeedTestGallery tests={data.speedTests} brandName={data.name} />
    )}

    <!-- FAQ -->
    {data.faq && data.faq.length > 0 && (
      <FAQAccordion faqs={data.faq} />
    )}

    <!-- Sticky Bottom CTA -->
    <div class="fixed bottom-0 left-0 right-0 p-4 bg-[var(--bg-color)]/90 backdrop-blur-md border-t border-[var(--border-color)] md:hidden z-40 flex justify-center shadow-[0_-10px_30px_rgba(0,0,0,0.05)]">
      <CTAButton href={data.affiliateLink} className="w-full max-w-sm py-3 px-4" text={`前往 ${data.name} 官网`} />
    </div>

    <!-- Desktop CTA -->
    <div class="hidden md:flex justify-center mt-16 mb-8">
      <CTAButton href={data.affiliateLink} text={`前往 ${data.name} 官网获取服务`} />
    </div>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>
