---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CompareTable from '../components/CompareTable.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import RatingBadge from '../components/RatingBadge.astro';

const allReviews = await getCollection('reviews');
// Sort by rating or just take the first 4 for the 'Top 4' list
const topReviews = allReviews.sort((a, b) => b.data.rating.overall - a.data.rating.overall).slice(0, 4);

// Format for CompareTable
const compareBrands = topReviews.map(review => ({
  name: review.data.name,
  score: review.data.rating.overall,
  price: review.data.pricing?.[0]?.price || '暂无数据',
  protocol: 'Shadowsocks / V2Ray', // Placeholder as not in schema yet
  link: review.data.affiliateLink
}));

const homeFaqs = [
  { question: "新手应该如何选择代理服务？", answer: "建议首先明确您的需求：是注重看流媒体（Netflix/Disney+），还是注重晚高峰的稳定性（办公/游戏）。一般建议新手从月付开始尝试，避免一次性投入过多风险。" },
  { question: "免费节点安全吗？", answer: "免费节点往往存在隐私泄露风险和不稳定的问题。如果您对数据安全有要求，建议选择付费的专业服务提供商，我们评测的均为运营半年以上的付费品牌。" },
  { question: "专线（IEPL/IPLC）和普通中转有什么区别？", answer: "专线不经过公共互联网拥堵节点，晚高峰时延迟更低、速度更稳定，但价格相对较高。普通中转性价比更高，适合日常使用。" }
];
---

<BaseLayout 
  title="懂机场 - 机场评测与选购指南 | dongjichang.com" 
  description="懂机场帮你把机场服务讲清楚：真实测速、套餐比价、不踩坑选购指南。"
>
  <!-- Hero Section -->
  <div class="relative bg-black text-white overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-40">
      <!-- Use the generated SVG background -->
      <img src="/src/assets/hero-bg.svg" alt="Hero Background" class="w-full h-full object-cover" />
    </div>
    <div class="container mx-auto px-4 py-24 md:py-32 relative z-10 text-center max-w-3xl">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 tracking-tight">
        懂机场，<span class="text-primary-400">少踩坑</span>
      </h1>
      <p class="text-lg md:text-xl text-white/80 mb-10 leading-relaxed">
        我们收录了数十家主流服务商。不看广告，只看疗效，替你把关，把机场讲清楚。
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/best" class="bg-primary-600 hover:bg-primary-500 text-white px-8 py-4 rounded-md font-bold transition-all cyber-glow border border-primary-400/50">
          查看场景推荐榜单
        </a>
        <a href="#top-reviews" class="bg-white/5 hover:bg-white/10 backdrop-blur border border-white/10 hover:border-primary-400 text-white px-8 py-4 rounded-md font-medium transition-all">
          浏览最新测评
        </a>
      </div>
      
      <div class="mt-12 flex justify-center gap-8 text-sm text-white/60">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          {allReviews.length} 家收录
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          10+ 测速维度
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          每月复核更新
        </div>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 py-16 max-w-6xl">
    <!-- Top Reviews Cards -->
    <section id="top-reviews" class="mb-20">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold text-[var(--text-color)]">精选品牌评测</h2>
        <a href="/brands" class="text-primary-600 dark:text-primary-400 font-medium hover:underline flex items-center gap-1">
          查看全部 <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {topReviews.map(review => (
          <a href={`/reviews/${review.id}`} class="group flex flex-col bg-[var(--card-bg)] border border-[var(--border-color)] rounded-lg overflow-hidden hover:border-primary-500 hover:shadow-[0_0_15px_rgba(99,102,241,0.1)] transition-all">
            <div class="p-6 flex-grow">
              <div class="flex justify-between items-start mb-4">
                <div class="w-12 h-12 rounded-lg overflow-hidden bg-[var(--bg-color)] border border-[var(--border-color)] p-1">
                  <img src={`/src/assets/brands/${review.id}.svg`} alt={`${review.data.name} Logo`} class="w-full h-full object-cover rounded-lg" />
                </div>
                <RatingBadge score={review.data.rating.overall} size="sm" />
              </div>
              <h3 class="text-xl font-bold text-[var(--text-color)] mb-2 group-hover:text-primary-500 transition-colors">{review.data.name}</h3>
              <p class="text-sm text-[var(--text-color)]/70 line-clamp-3">{review.data.summary}</p>
            </div>
            <div class="px-6 py-4 border-t border-[var(--border-color)] bg-[var(--bg-color)]/50 group-hover:bg-primary-50 dark:group-hover:bg-primary-900/20 flex justify-between items-center transition-colors">
              <span class="text-sm font-medium text-primary-600 dark:text-primary-400">查看深度评测</span>
              <svg class="w-4 h-4 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Compare Quick View -->
    <section class="mb-20">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-[var(--text-color)] mb-4">核心参数横向对比</h2>
        <p class="text-[var(--text-color)]/70 max-w-2xl mx-auto">直观比对价格、评分与协议，找到最符合您预算与使用习惯的方案。</p>
      </div>
      <CompareTable brands={compareBrands} />
      <div class="text-center mt-6">
        <a href="/compare" class="inline-block px-6 py-3 bg-[var(--bg-color)] border border-[var(--border-color)] hover:border-primary-500 text-[var(--text-color)] rounded-lg font-medium transition-colors">
          查看完整参数对比表
        </a>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="mb-10 max-w-3xl mx-auto">
      <FAQAccordion faqs={homeFaqs} />
    </section>
  </div>
</BaseLayout>
